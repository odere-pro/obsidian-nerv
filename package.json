{
  "name": "obsidian-nerv",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint --no-error-on-unmatched-pattern",
    "lint:fix": "eslint --fix --no-error-on-unmatched-pattern",
    "prettier": "prettier --check \"**/*.{ts,json,md,yml}\"",
    "prettier:fix": "prettier --write \"**/*.{ts,json,md,yml}\"",
    "typecheck": "tsc --noEmit",
    "format": "npm run lint:fix && npm run prettier:fix",
    "validate": "npm run format && npm run typecheck",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.5.0",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.2"
  }
}
