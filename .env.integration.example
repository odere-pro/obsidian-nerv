# Copy to .env.integration and fill in real values.

# Obsidian vault name to use for integration tests
NERV_TEST_VAULT=e2e-integration-test-vault

# Vault root directory for integration tests (default: ./docs/vaults)
NERV_VAULT_PATH=./docs/vaults

# Set to 1 to keep the test vault on disk and leave Obsidian open after tests.
# Default (unset): teardown deletes the vault directory and quits Obsidian.
# NERV_SKIP_CLEANUP=1
