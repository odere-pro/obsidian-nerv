# Copy to .env.integration and fill in values before running integration tests.
# bun test tests/integration/ --env-file=.env.integration

# Obsidian vault name to use for integration tests
NERV_TEST_VAULT=e2e-integration-test-vault

# Vault root directory for integration tests (default: ./docs/vaults)
NERV_VAULT_PATH=./docs/vaults
